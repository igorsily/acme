{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server",
      "cwd": "${workspaceFolder}/apps/server",
      "program": "${workspaceFolder}/apps/server/node_modules/tsx/dist/cli.mjs",
      "args": [
        "watch",
        "src/index.ts"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Bun)",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--inspect-wait",
        "src/index.ts"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/apps/server/.env"
    }
  ]
}