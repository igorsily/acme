# PostgreSQL (PostGIS recomendado para coordenadas de item)
DATABASE_URL=postgresql://postgres:password@localhost:5432/acme

# Better Auth — secret com pelo menos 32 caracteres
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:3000

# Origem do frontend (CORS + cookies)
CORS_ORIGIN=http://localhost:3001

PORT=3000
NODE_ENV=development

# Opcional: Redis
# REDIS_URL=redis://localhost:6379

# Opcional: e-mail transacional (convites)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Acme <convites@example.com>

# Opcional: Sentry (API)
# SENTRY_DSN_API=https://your-dsn@o000000.ingest.us.sentry.io/0000000

# Opcional: domínio raiz para cookies entre subdomínios em produção
# AUTH_COOKIE_DOMAIN=seu-dominio.com
