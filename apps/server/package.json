{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --watch src/index.ts",
    "migrate": "node dist/migrate.mjs",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/env": "workspace:*",
    "@sentry/node": "^10",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.7.0",
    "@hono/trpc-server": "^0.4.0",
    "@scalar/fastify-api-reference": "^1.58.0",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/node": "^22.13.14",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
