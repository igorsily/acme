POSTGRES_DB=acme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGIS_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

API_IMAGE=igorsily/acme-api:latest
WEB_IMAGE=igorsily/acme-web:latest

TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_EMAIL=ops@example.com
TRAEFIK_DASHBOARD=false
DOCKER_API_VERSION=1.40

WEB_DOMAIN=web.localhost
API_DOMAIN=api.localhost
NEXT_PUBLIC_SERVER_URL=http://api.localhost
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o000000.ingest.us.sentry.io/0000000
SENTRY_DSN=https://your-dsn@o000000.ingest.us.sentry.io/0000000
SENTRY_DSN_API=https://your-api-dsn@o000000.ingest.us.sentry.io/0000000
BETTER_AUTH_URL=http://api.localhost
CORS_ORIGIN=http://web.localhost
# Domínio raiz para compartilhar cookies entre app.* e api.* (obrigatório em produção)
# AUTH_COOKIE_DOMAIN=seu-dominio.com
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Acme <convites@example.com>

WATCHTOWER_POLL_INTERVAL=86400
